{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KiVi",
  "version": "0.1.0",
  "identifier": "app.kivi.desktop",
  "build": {
    "frontendDist": "../dist/web",
    "beforeDevCommand": "python3 tools/build_web.py",
    "beforeBuildCommand": "python3 tools/build_web.py"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "KiVi",
        "url": "inbox.html",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https://avatars.githubusercontent.com https://github.githubassets.com https://gitlab.com https://secure.gravatar.com",
        "connect-src": "'self' ipc: http://ipc.localhost blob: data: https:",
        "worker-src": "'self' blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "category": "DeveloperTool",
    "copyright": "Copyright © 2026 XyleMora",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md"
    },
    "shortDescription": "KiCad viewer and hardware review for GitHub",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"]
  }
}
